# ─────────────────────────────────────────────────────────────────────────────
# Strumode IG Agent — environment variable NAMES (no values here, ever).
#
# In production these are set as **GitHub Actions secrets** (repo → Settings →
# Secrets and variables → Actions). Jack sets them; the code only references
# them by name. For LOCAL dry-run testing you may copy this file to `.env` and
# fill values — `.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Claude API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# OpenAI API key (platform.openai.com → API keys) — powers gpt-image-1 visuals
OPENAI_API_KEY=

# Instagram (Instagram API with Instagram Login) long-lived user access token.
# 60-day token; the monthly token-refresh workflow keeps it alive.
IG_ACCESS_TOKEN=

# Instagram professional-account user ID (shown in the Meta app "API setup").
IG_USER_ID=

# ManyChat Account API key (ManyChat -> Settings -> API -> Generate your API
# Key). Only used to push the weekly Value Day prompt payload into a ManyChat
# Bot Field (setBotFieldByName) — never used to touch flows, subscribers, or
# send any message. Only needed if publishing.manychat_sync is true in
# config.yaml.
MANYCHAT_API_KEY=

# GitHub Personal Access Token — used ONLY by the token-refresh workflow to
# write the new IG_ACCESS_TOKEN back into repo secrets, and by the publish
# workflow to push approved images to the public assets repo.
# Fine-grained: strumode-ig-agent (Secrets: R/W) + strumode-ig-assets (Contents: R/W).
# Classic fallback: `repo` scope. NOT referenced by application code directly.
GH_PAT=

# Optional instant kill-switch (repo Actions VARIABLE, not secret). Set to "1"
# to pause every workflow with no commit. Also settable via config.yaml `paused`.
AGENT_PAUSED=
